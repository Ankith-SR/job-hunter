# ── LLM API (free tier at https://integrate.api.nvidia.com) ──────────────────
GROK_API_KEY=nvapi-your-key-here
GROK_BASE_URL=https://integrate.api.nvidia.com/v1
GROK_MODEL=meta/llama-3.3-70b-instruct

# ── Apify (scraping LinkedIn + Handshake) ─────────────────────────────────────
APIFY_API_TOKEN=apify_api_your-token-here
APIFY_ACTOR_ID=orgupdate/handshake-jobs-scraper

# ── Gmail (for saving email drafts) ──────────────────────────────────────────
# Also place credentials.json (OAuth Desktop app) in the project root
EMAIL_ADDRESS=you@gmail.com

# ── Optional Apify settings ───────────────────────────────────────────────────
APIFY_USE_PROXY=true
APIFY_MAX_ITEMS=50
